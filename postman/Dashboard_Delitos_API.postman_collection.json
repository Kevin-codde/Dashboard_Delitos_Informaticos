              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"password\": \"{{passAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenAdmin\", datos.access_token);",
                  "pm.test(\"Devuelve token, rol y menú\", function () { pm.expect(datos.access_token).to.be.a(\"string\"); pm.expect(datos.menu).to.be.an(\"array\"); });"
                ]
