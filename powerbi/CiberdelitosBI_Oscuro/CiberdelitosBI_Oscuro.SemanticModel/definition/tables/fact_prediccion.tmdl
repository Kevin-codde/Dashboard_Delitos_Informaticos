table fact_prediccion
	lineageTag: d8f3be55-ae35-5966-80c8-70d490469983

	measure 'Casos Estimados' = VAR _a = IF(ISFILTERED(dim_departamento[departamento]), "Departamento", "Nacional") RETURN CALCULATE(SUM(fact_prediccion[casos_estimados]), fact_prediccion[ambito] = _a)
		formatString: #,0
		displayFolder: Predicción
		lineageTag: 62a9431e-4183-5553-896f-49f4476c2717

	measure 'Casos Último Año (parcial)' = VAR _a = IF(ISFILTERED(dim_departamento[departamento]), "Departamento", "Nacional") RETURN CALCULATE(SUM(fact_prediccion[casos_ultimo_anio]), fact_prediccion[ambito] = _a)
		formatString: #,0
		displayFolder: Predicción
		lineageTag: c75e6aac-0944-561b-ba7c-470332fff31e

	measure 'Año Proyectado' = MAX(fact_prediccion[anio_proyectado])
		formatString: 0
		displayFolder: Predicción
		lineageTag: 91e61902-a3a1-533d-8596-62f31559c7be

	measure 'Error Medio (MAE)' = VAR _a = IF(ISFILTERED(dim_departamento[departamento]), "Departamento", "Nacional") RETURN CALCULATE(AVERAGE(fact_prediccion[mae_modelo]), fact_prediccion[ambito] = _a)
		formatString: #,0.0
		displayFolder: Predicción
		lineageTag: fedf43d4-6500-5ee7-ac50-8b524cce1d56

	measure 'Tipología de Mayor Riesgo' = VAR _t = TOPN(1, VALUES(dim_tipologia[tipologia]), [Casos Estimados], DESC) RETURN CONCATENATEX(_t, dim_tipologia[tipologia], ", ")
		displayFolder: Predicción
		lineageTag: 431166a0-b2e2-5e83-b93e-2133c7cd184a

	column ambito
		dataType: string
		isHidden
