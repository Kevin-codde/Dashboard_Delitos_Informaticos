	partition fact_prediccion = m
		mode: import
		source =
				let
					Origen = Excel.Workbook(File.Contents(RutaExcel), true, true),
					Hoja = Origen{[Item = "fact_prediccion", Kind = "Sheet"]}[Data],
					Tipos = Table.TransformColumnTypes(Hoja, {{"ambito", type text}, {"departamento", type text}, {"codigo_tipologia", type text}, {"casos_ultimo_anio", Int64.Type}, {"casos_estimados", Int64.Type}, {"anio_proyectado", Int64.Type}, {"mae_modelo", type number}})
				in
					Tipos

	annotation PBI_ResultType = Table

