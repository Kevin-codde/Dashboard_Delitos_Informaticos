model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-CO
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_fecha","dim_departamento","dim_geografia","dim_tipologia","fact_incidentes","fact_prediccion","RutaExcel"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table dim_fecha
ref table dim_departamento
ref table dim_geografia
ref table dim_tipologia
ref table fact_incidentes
ref table fact_prediccion

ref cultureInfo en-US

